OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=llama3
SAFETY_THRESHOLD=0.8
LOG_DB_PATH=sentinel_audit.db

# Gateway authentication. Generate real values; never commit them.
# Comma-separated list of accepted API keys:
SENTINEL_API_KEYS=change-me-key-1,change-me-key-2
# Secret used to sign and verify JWT bearer tokens (use a long random string):
SENTINEL_JWT_SECRET=change-me-to-a-long-random-string

# Optional: delegate prompt-injection checks to ai-sentinel
AI_SENTINEL_URL=
AI_SENTINEL_API_KEY=
